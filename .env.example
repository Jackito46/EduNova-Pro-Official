# ==============================================================================
# EduNova Pro - Modèle de Configuration d'Environnement (.env.example)
# ==============================================================================
# ATTENTION DE SÉCURITÉ :
# Ne committez JAMAIS de fichier .env contenant de vraies clés secrètes dans Git !
# Ce fichier sert de modèle. Copiez-le en .env sur votre serveur (Coolify / VPS)
# et renseignez les valeurs réelles.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT WEB (FRONTEND VITE - EXPOSÉ AU NAVIGATEUR)
# ------------------------------------------------------------------------------
# Les variables préfixées par VITE_ sont intégrées au code JavaScript compilé
# et sont donc VISIBLES par tout utilisateur dans son navigateur.
# N'y mettez JAMAIS de clé secrète (ex: service_role, mot de passe SMTP, etc.) !

# URL publique de votre instance Supabase (ou votre instance auto-hébergée sur Coolify)
VITE_SUPABASE_URL=https://votre-projet.supabase.co

# Clé anonyme publique Supabase (soumise au Row Level Security / RLS)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...votre_cle_anon_publique

# URL publique de l'application (optionnel, pour les liens de redirection / PWA)
VITE_APP_URL=https://votre-domaine.com


# ------------------------------------------------------------------------------
# 2. SERVEUR BACKEND (SECRETS STRICTEMENT CONFIDENTIELS - JAMAIS EXPOSÉS)
# ------------------------------------------------------------------------------
# Ces variables ne sont JAMAIS transmises au client/navigateur. Elles sont
# lues exclusivement par Node.js (server.ts).

# Environnement d'exécution ('production' en déploiement réel, 'development' en local)
NODE_ENV=production

# Port d'écoute du serveur Node.js (3000 recommandé pour Docker & Coolify)
PORT=3000

# CLÉ MAÎTRESSE DE CHIFFREMENT (CRITIQUE POUR LA SÉCURITÉ DU COFFRE-FORT)
# Utilisée par l'algorithme AES-256-GCM pour chiffrer les clés MonCash, Natcash,
# Kobara et mots de passe SMTP avant enregistrement en base de données.
# Générez une clé aléatoire forte de 32 octets (ex: openssl rand -hex 32)
ENCRYPTION_KEY=changer_par_une_cle_hex_tres_securisee_32_octets_minimum_ici

# Clé secrète administrative Supabase (SERVICE_ROLE)
# OPTIONNEL : Utilisée uniquement par le serveur pour des tâches d'administration
# globales qui contournent le RLS (ex: imports de masse, scripts cron).
# ATTENTION : Ne JAMAIS préfixer par VITE_ ! Ne JAMAIS donner cette clé à quiconque !
SUPABASE_SERVICE_ROLE_KEY=

# Clé API Google Gemini pour les fonctionnalités d'intelligence artificielle
# (Génération de synthèses pédagogiques, analyse financière, aide aux devoirs).
# Consommée uniquement par le proxy sécurisé /api/gemini/*.
GEMINI_API_KEY=votre_cle_api_gemini_secrete

# NOTIFICATIONS PUSH WEB (VAPID)
# Permet l'envoi de notifications instantanées aux parents/élèves/enseignants.
# Générez vos clés VAPID avec: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@votre-domaine.com

# URL publique externe pour le mécanisme de Keep-Alive et webhooks
APP_URL=https://votre-domaine.com


# ------------------------------------------------------------------------------
# 3. PASSERELLES DE PAIEMENT (VALEURS PAR DÉFAUT OPTIONNELLES AU NIVEAU SERVEUR)
# ------------------------------------------------------------------------------
# Note : Chaque école peut configurer ses propres clés depuis l'interface
# "Coffre-fort API" dans l'application. Les variables ci-dessous ne servent que
# de repli global si configurées.

# MonCash Digicel (Haïti)
MONCASH_CLIENT_ID=
MONCASH_CLIENT_SECRET=
MONCASH_BUSINESS_KEY=
MONCASH_WEBHOOK_SECRET=
MONCASH_MODE=sandbox

# Kobara (Passerelle Unifiée MonCash & Natcash)
KOBARA_PUBLIC_KEY=
KOBARA_SECRET_KEY=
KOBARA_WEBHOOK_SECRET=
