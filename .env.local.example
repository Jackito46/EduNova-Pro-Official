# ==============================================================================
# Modèle d'environnement pour EduNova Pro — Mode Local / LAN sans Internet
# ==============================================================================
# NE REMPLISSEZ PAS CE FICHIER À LA MAIN SI VOUS UTILISEZ LE SCRIPT :
#   node deploy/local-lan/setup-local-env.mjs
# Ce script génère automatiquement un fichier .env.local sécurisé avec des clés
# JWT (ANON_KEY et SERVICE_ROLE_KEY) cryptographiquement cohérentes.
# ==============================================================================

# Mode de déploiement :
#   lan        = Serveur d'Établissement accessible sur le réseau local (0.0.0.0:3000)
#   standalone = Poste Autonome uniquement sur ce PC (127.0.0.1:3000)
EDUNOVA_DEPLOYMENT_MODE=lan
LAN_SERVER_LABEL=Serveur Principal Etablissement
LAN_HOSTNAME=edunova-server.local

# Interface réseau d'écoute :
#   0.0.0.0   = Tous les PC/tablettes du LAN peuvent se connecter
#   127.0.0.1 = Uniquement ce PC (Poste Autonome strict)
BIND_HOST=0.0.0.0
APP_PORT=3000

# Ports base de données / Kong exposés uniquement en local par défaut (sécurité)
PG_BIND_HOST=127.0.0.1
POSTGRES_PORT=5432
KONG_BIND_HOST=127.0.0.1
KONG_HTTP_PORT=8000

# Secrets Base de données & JWT (générés par setup-local-env.mjs)
POSTGRES_DB=postgres
POSTGRES_PASSWORD=REMPLACER_PAR_MOT_DE_PASSE_FORT
JWT_SECRET=REMPLACER_PAR_SECRET_JWT_MINIMUM_48_CARACTERES
JWT_EXPIRY=3600

# Clés JWT signées avec JWT_SECRET (rôle: anon et service_role)
ANON_KEY=
SERVICE_ROLE_KEY=

# Clé maîtresse AES-256-GCM (64 caractères hexadécimaux)
ENCRYPTION_KEY=
DEMO_REQUEST_SECRET=

# En LAN hors-ligne, active la validation automatique des comptes créés localement
ENABLE_EMAIL_AUTOCONFIRM=true
DISABLE_SIGNUP=false

# Optionnel : adresse fixe du serveur sur le réseau local (ex: http://192.168.1.100:3000)
APP_URL=http://localhost:3000
SITE_URL=http://localhost:3000
API_EXTERNAL_URL=http://localhost:3000/local-supabase
